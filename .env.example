# Шаблон переменных окружения. Скопировать в .env и заполнить.
# Настоящий .env в git не попадает (см. .gitignore).

# --- Существующий бот (worker) ---
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# --- Общее для worker и web ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- SAT-витрина: синк из Google (нужно только worker'у) ---
# JSON-ключ сервис-аккаунта целиком, одной строкой.
# Не забыть расшарить таблицу на email сервис-аккаунта с правами Viewer,
# иначе Sheets API вернёт 403 при полностью валидном ключе.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID таблицы из её URL: docs.google.com/spreadsheets/d/<SAT_SHEET_ID>/edit
SAT_SHEET_ID=
# Имена листов. Можно не заполнять — определятся автоматически по заголовку
# (лист со словом «анализ» — сводная, со словом «журнал» — журнал).
# Задавать явно только если автоопределение ошиблось.
# SAT_DASHBOARD_SHEET=
# SAT_JOURNAL_SHEET=

# ВНИМАНИЕ: четыре переменные Google выше нужны и веб-сервису тоже —
# кнопка «Обновить» на витрине читает таблицу сама, не дожидаясь воркера.

# --- SAT-витрина: сайт (нужно только web) ---
# Канал, подписка на который открывает доступ. Числовой ID (-100...) или @username.
# Бот должен быть админом этого канала, иначе getChatMember не отдаст статус.
SAT_CHANNEL_ID=
# Секрет для подписи сессионной куки. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Username бота без @ — его показывает кнопка входа.
SAT_BOT_USERNAME=
# Внешний адрес сайта, например https://sat.up.railway.app
# Домен обязан совпадать с заданным боту через /setdomain в @BotFather,
# иначе Telegram не отрисует кнопку входа.
PUBLIC_BASE_URL=

# --- Необязательное, у всего есть значения по умолчанию ---
# SAT_SYNC_INTERVAL=600      # секунд между опросами Google Sheets
# SAT_POOL_MAX_SIZE=5        # соединений к Postgres на процесс
# SAT_SESSION_TTL=604800     # срок жизни сессионной куки, секунд
# SAT_AUTH_MAX_AGE=86400     # предельный возраст ответа Login Widget, секунд
# SAT_MEMBERSHIP_TTL=3600    # как долго доверять проверенной подписке, секунд
# SAT_COOKIE_SECURE=true     # false ТОЛЬКО для локальной отладки по http
